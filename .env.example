# 运行时：只用 DeepSeek（接触孩子数据）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# 离线内容生产：可以用 OpenAI（不含孩子数据）
OPENAI_API_KEY=
DATABASE_URL=

# 语音：明确开启且服务端密钥非空才启用
DEEPSEEK_SPEECH_ENABLED=

# 家长入口默认关闭；单户试点由服务端配置，口令至少24字符。
PARENT_ACCESS_PASSWORD=
PARENT_ALLOWED_CHILD_IDS=

# 离线公开资料查证：精确true才启用；默认关闭
DEEPSEEK_RESEARCH_ENABLED=
