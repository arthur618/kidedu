// 数据库结构。字段以 src/contracts/schemas.ts 里的同名类型为准。
// 数组和嵌套对象用 JSON 字符串列存；SQLite 地址从环境变量 DATABASE_URL 读。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Child {
  id                String @id
  nickname          String
  grade             Int
  interests         String
  dailyLimitMinutes Int
}

model Lesson {
  id             String @id
  grade          Int
  term           String
  lessonNo       Int
  title          String
  recognizeChars String
  writeChars     String
  words          String
  status         String
}

model CharCard {
  id                String  @id
  char              String  @unique
  pinyin            String
  radical           String
  explain           String
  words             String
  confusable        String
  dictationContext  String
  audioUrl          String?
  source            String
  status            String
}

model Passage {
  id              String @id
  title           String
  body            String
  topic           String
  sourceType      String
  targetChars     String
  outOfScopeCount Int
  question        String
  keyPoints       String
  status          String
}

model ChildChar {
  childId       String
  char          String
  kind          String
  stage         String
  correctStreak Int
  nextReviewOn  String?
  wrongCount    Int
  lastSeenOn    String?

  @@id([childId, char])
  @@index([childId])
}

model Session {
  id        String  @id
  childId   String
  startedAt String
  endedAt   String?
  homework  String

  @@index([childId])
}

model Turn {
  id                String @id
  sessionId         String
  agent             String
  model             String
  input             String
  output            String
  inputTokens       Int
  cachedInputTokens Int
  outputTokens      Int
  latencyMs         Int
  guardVerdict      String
  createdAt         String

  @@index([sessionId])
}

model Incident {
  id        String  @id
  type      String
  turnId    String?
  note      String
  resolved  Boolean
  revision  Int @default(0)
  createdAt String
}

// 会话的运行时状态与上下文。契约里的 Session 只有孩子、时间、作业清单，
// 所以状态机和上下文单独放这张内部表（不影响任何契约类型）。
model SessionRuntime {
  sessionId String @id
  state     String
  context   String
}

// C7 内部命令日志；pending/response 只能放去图数据。
model SessionCommand {
  scope       String
  key         String
  fingerprint String
  kind        String
  sessionId   String?
  phase       String
  pending     String
  response    String?
  sequence    Int @id @default(autoincrement())

  @@unique([scope, key])
  @@index([sessionId, sequence])
}

// 教练活动与 SessionContext 分离；同字第二次活动由 activity 区分。
model CoachRuntime {
  sessionId String @id
  data      String
}

// C9 私有快照与孩子原话，禁止整体投影到HTTP或Turn。
model ReadingRuntime {
  sessionId String @id
  data String
}

// C10 原话、正文与恢复载荷仅在私有活动表。
model EssayRuntime {
  sessionId String @id
  data String?
  commands String @default("{}")
}

// C11A：真实学习事件追加流水；不依赖当前进度反推历史。
model LearningOutcome {
  id String @id
  sessionId String
  childId String
  commandScope String
  commandKey String
  effectIndex Int
  char String
  kind String
  stageBefore String
  stageAfter String
  result String
  occurredAt String
  @@unique([commandScope, commandKey, effectIndex])
  @@index([childId, occurredAt])
}
model SessionLearningCoverage {
  sessionId String @id
  startedAt String
}
// snapshot/step.result为私有来源与评分；公共日报另行严格投影。
model NightlyJob {
  id Int @id @default(autoincrement())
  childId String
  date String
  timezone String
  sourceVersion String
  snapshot String
  leaseToken String?
  leaseUntil String?
  final String?
  @@unique([childId, date, timezone, sourceVersion])
}
model NightlyStep {
  jobId Int
  key String
  inputFingerprint String
  reusedFromJobId Int?
  status String
  result String?
  error String?
  @@id([jobId, key, inputFingerprint])
}
model NightlyPublication {
  childId String
  date String
  timezone String
  jobId Int
  data String
  @@id([childId, date, timezone])
}

// C11B 仅hash凭证；过期不触发学习数据清理。
model ParentAccessSession {
  tokenHash String @id
  configFingerprint String
  expiresAt String
  revoked Boolean @default(false)
}
model ParentLoginLimit {
  bucket String @id
  windowStart String
  attempts Int
}
model IncidentContext {
  incidentId String @id
  childId String
  sessionId String
  @@index([childId, incidentId])
  @@index([sessionId])
}
model ParentReviewAudit {
  id String @id
  incidentId String
  childId String
  actor String
  requestId String @unique
  revisionBefore Int
  revisionAfter Int
  resolvedBefore Boolean
  resolvedAfter Boolean
  createdAt String
  @@index([childId, incidentId])
}
model ParentReviewRequest {
  requestId String @id
  childId String
  incidentId String
  fingerprint String
  response String
  @@index([childId])
}
