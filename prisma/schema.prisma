// 数据库结构。字段以 src/contracts/schemas.ts 里的同名类型为准。
// 数组和嵌套对象用 JSON 字符串列存；SQLite 地址从环境变量 DATABASE_URL 读。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Child {
  id                String @id
  nickname          String
  grade             Int
  interests         String
  dailyLimitMinutes Int
}

model Lesson {
  id             String @id
  grade          Int
  term           String
  lessonNo       Int
  title          String
  recognizeChars String
  writeChars     String
  words          String
  status         String
}

model CharCard {
  id                String  @id
  char              String  @unique
  pinyin            String
  radical           String
  explain           String
  words             String
  confusable        String
  dictationContext  String
  audioUrl          String?
  source            String
  status            String
}

model Passage {
  id              String @id
  title           String
  body            String
  topic           String
  sourceType      String
  targetChars     String
  outOfScopeCount Int
  question        String
  keyPoints       String
  status          String
}

model ChildChar {
  childId       String
  char          String
  kind          String
  stage         String
  correctStreak Int
  nextReviewOn  String?
  wrongCount    Int
  lastSeenOn    String?

  @@id([childId, char])
  @@index([childId])
}

model Session {
  id        String  @id
  childId   String
  startedAt String
  endedAt   String?
  homework  String

  @@index([childId])
}

model Turn {
  id                String @id
  sessionId         String
  agent             String
  model             String
  input             String
  output            String
  inputTokens       Int
  cachedInputTokens Int
  outputTokens      Int
  latencyMs         Int
  guardVerdict      String
  createdAt         String

  @@index([sessionId])
}

model Incident {
  id        String  @id
  type      String
  turnId    String?
  note      String
  resolved  Boolean
  createdAt String
}

// 会话的运行时状态与上下文。契约里的 Session 只有孩子、时间、作业清单，
// 所以状态机和上下文单独放这张内部表（不影响任何契约类型）。
model SessionRuntime {
  sessionId String @id
  state     String
  context   String
}

// C7 内部命令日志；pending/response 只能放去图数据。
model SessionCommand {
  scope       String
  key         String
  fingerprint String
  kind        String
  sessionId   String?
  phase       String
  pending     String
  response    String?
  sequence    Int @id @default(autoincrement())

  @@unique([scope, key])
  @@index([sessionId, sequence])
}

// 教练活动与 SessionContext 分离；同字第二次活动由 activity 区分。
model CoachRuntime {
  sessionId String @id
  data      String
}

// C9 私有快照与孩子原话，禁止整体投影到HTTP或Turn。
model ReadingRuntime {
  sessionId String @id
  data String
}

// C10 原话、正文与恢复载荷仅在私有活动表。
model EssayRuntime {
  sessionId String @id
  data String?
  commands String @default("{}")
}
